{
    "window_title": "极简文件管理器",
    "initial_size": [900,600],
    "file_list_bg_alpha": 100,
    "nav_tree_bg_alpha": 100,
    "background_image": "media/background.png",
    "background_alpha": 150,
    "font_size": 15,
    "font_family": "Microsoft YaHei",
    "nav_tree_icon_size": 60,
    "file_list_icon_size": 40,
    "drive_icon_size": 60,
    "file_list_font_size": 15,
    "nav_tree_font_size": 15,
    "drive_font_size": 13,
    "show_hidden_files": false,
    "show_all_sizes": false,
    "statusbar_visible": true,
    "language": "zh_CN",
    "start_path": "X:\\",
    "log_level": "info",
    "start_random": false,
    "show_mtime": false,
    "scan_exclude_system": [
        {"name": "pagefile.sys", "desc": "Windows 页面文件", "checked": true},
        {"name": "hiberfil.sys", "desc": "Windows 休眠文件", "checked": true},
        {"name": "$RECYCLE.BIN", "desc": "回收站", "checked": true},
        {"name": "System Volume Information", "desc": "系统卷标信息", "checked": true},
        {"name": "swapfile.sys", "desc": "交换文件", "checked": true}
    ],
    "scan_exclude_custom": []
}